# Banco original Supabase; Session pooler 5432 ou conexão direta, com SSL.
DATABASE_URL=
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Segredo exclusivo de sessão, mínimo de 32 bytes. Somente no backend.
JWT_SECRET=

# Demo já conectada: o token permanece no banco. Não refazer OAuth.
NUVEMSHOP_STORE_ID=
NUVEMSHOP_USER_AGENT=
STOCK_DECREASES_ENABLED=false

# Ativar após revisão/migração e validação no banco de teste.
EXTERNAL_SALES_ENABLED=false
# Leitura de pedidos online: exige read_orders, sem criar pedidos.
ONLINE_ORDERS_ENABLED=false

# Extensão operacional: ativar somente após migração e permissões conferidas.
INVITATIONS_ENABLED=false
STOCK_CONFERENCES_ENABLED=false
STORE_SETTINGS_ENABLED=false
STOCK_NOTIFICATIONS_ENABLED=false
# Agendamento Vercel; mínimo de 32 bytes, exclusivo do backend.
CRON_SECRET=
# Usa o adaptador Resend existente; remetente verificado.
STOCK_ALERT_FROM_EMAIL=

# Aplicativo Nuvemshop: assinatura de webhooks em produção.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=

# Identificador do OAuth e do adaptador opcional de privacidade.
PORTERO_INSTALLATION_ID=
# Segredo apenas da primeira instalação administrativa, não da operação da demo.
INSTALLATION_ADMIN_TOKEN=

# Adaptador Resend já existente, opcional e dispensável para a demo.
# Sem canal de atendimento, solicitações de dados não são confirmadas.
RESEND_API_KEY=
PRIVACY_FROM_EMAIL=
PRIVACY_MERCHANT_EMAIL=
