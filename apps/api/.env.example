# Copie a URL PostgreSQL do Session pooler (porta 5432) no painel Connect do Supabase.
# Configure SSL na URL com sslmode=require. Nunca versione credenciais reais.
DATABASE_URL=
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Gere localmente pelo menos 32 bytes aleatórios com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Cole o resultado somente no JWT_SECRET do .env local; nunca versione o segredo.
JWT_SECRET=
