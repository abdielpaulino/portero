# PostgreSQL via Session pooler (porta 5432), com sslmode=require.
# Credenciais devem permanecer no backend, sem versionamento.
DATABASE_URL=
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Segredo exclusivo do backend, com pelo menos 32 bytes aleatórios.
JWT_SECRET=

# OAuth limitado a desenvolvimento e à loja demo configurada.
# CLIENT_ID, CLIENT_SECRET e USER_AGENT são obrigatórios para habilitar o OAuth.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Vazio permite apenas /auth/nuvemshop/setup; confirmar o user_id antes de conectar.
# Baixas de estoque exigem desenvolvimento e correspondência exata com este ID.
NUVEMSHOP_DEMO_STORE_ID=
# Identificação exigida pela Nuvemshop: PORTERO (contato@example.com).
NUVEMSHOP_USER_AGENT=
