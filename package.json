{
  "name": "portero",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@portero/web",
    "dev:api": "npm run dev --workspace=@portero/api",
    "build:web": "npm run build --workspace=@portero/web",
    "build:api": "npm run build --workspace=@portero/api",
    "db:generate": "npm run db:generate --workspace=@portero/api",
    "db:migrate": "npm run db:migrate --workspace=@portero/api"
  }
}
